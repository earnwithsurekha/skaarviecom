# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skaarvi_resell_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# File Storage (local for development, s3 for production)
STORAGE_DRIVER=local
# AWS S3 Configuration (required when STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=skaarvi-reseller-files

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=skaarviresell@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Skaarvi Reseller <skaarviresell@gmail.com>
# The support contact shown in order emails is derived from EMAIL_FROM.
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000

# Firebase Admin SDK (server-only; configure one credential method)
# Recommended for ECS: base64-encoded service account JSON from Secrets Manager.
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
# Or configure the three fields below instead:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Local alternative: absolute path to the downloaded service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json

# SMS Configuration - MSG91 (Recommended for India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=SKAARV
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=10
SMS_ENABLED=true
SMS_PROVIDER=msg91

# SMS Configuration - Twilio (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_API_URL=your_whatsapp_api_url
WHATSAPP_API_KEY=your_whatsapp_api_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=5
DEFAULT_RESELLER_COMMISSION=10
FRONTEND_URL=http://localhost:3000
