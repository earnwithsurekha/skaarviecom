# Next.js Application Environment Variables

# Application
NEXT_PUBLIC_APP_NAME=Skaarvi Manufacturer Panel
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skaarvi_resell_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# AWS S3 Configuration
# For S3 file storage - get credentials from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=skaarvi-reseller-files

# Email Configuration (SendGrid/AWS SES)
EMAIL_FROM=noreply@skaarvi.com
SENDGRID_API_KEY=your_sendgrid_api_key

# SMS Configuration - MSG91 (Recommended for India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=SKAARV
MSG91_TEMPLATE_ID=your_msg91_template_id
SMS_ENABLED=true
NEXT_PUBLIC_SMS_ENABLED=true
NEXT_PUBLIC_OTP_LENGTH=6

# SMS Configuration - Twilio (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_API_URL=your_whatsapp_api_url
WHATSAPP_API_KEY=your_whatsapp_api_key

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=5
DEFAULT_RESELLER_COMMISSION=10

# Redis Configuration (optional for caching)
REDIS_URL=redis://localhost:6379
